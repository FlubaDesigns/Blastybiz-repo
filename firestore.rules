rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Businesses — owner only (uid field matches auth uid, not document ID)
    match /businesses/{businessId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Listing drafts — owner only
    match /listingDrafts/{draftId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Publish jobs — owner only (create + read; backend updates status)
    match /publishJobs/{jobId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Platform connections — owner only
    match /platformConnections/{connId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Subscriptions — owner read only (written by Stripe webhook backend)
    match /subscriptions/{subId} {
      allow read: if request.auth != null && request.auth.uid == subId;
      allow write: if false;
    }

    // Activity logs — owner read only (written by backend)
    match /activityLogs/{logId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Reviews — owner read only (written by backend)
    match /reviews/{reviewId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

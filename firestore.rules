rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — full read access across all collections.
    // info@blastybiz.com is the permanent bootstrap admin (cannot be removed via UI).
    // Additional admins are stored in config/admins and managed from Admin-Operate.html.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'info@blastybiz.com' ||
        (exists(/databases/$(database)/documents/config/admins) &&
         request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails)
      );
    }

    // Users can only read/write their own user doc; admin can read any.
    // plan, planActive, and aiUsage are server-only — blocked from client writes.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Admin can write any field (plan override tool, support, etc.)
      allow write: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.plan == 'starter';
      // ⚠️  MAINTAINED DENYLIST — if you add a new billing/entitlement field to users docs
      //     (e.g. squareCustomerId, subscriptionId, usageCounters) you MUST add it here too,
      //     or it will be client-writable by default.
      allow update: if request.auth != null && request.auth.uid == userId
        && !('plan'           in request.resource.data.diff(resource.data).affectedKeys())
        && !('planActive'     in request.resource.data.diff(resource.data).affectedKeys())
        && !('aiUsage'        in request.resource.data.diff(resource.data).affectedKeys())
        && !('aiActionsUsed'  in request.resource.data.diff(resource.data).affectedKeys())
        && !('aiActionsResetAt' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Businesses — owner only; admin can read or delete any.
    // Owner check: uid field on the doc OR the doc ID (activeBizId defaults to user.uid).
    // ⚠️  MAINTAINED DENYLIST — billing fields written by Square webhook must be listed here.
    //     If you add squareOrderId, trialEndsAt, etc. to business docs, add them below too.
    match /businesses/{businessId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId ||
         isAdmin());
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.uid ||
         request.auth.uid == businessId);
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId)
        && !('currentPlan'          in request.resource.data.diff(resource.data).affectedKeys())
        && !('subscriptionStatus'   in request.resource.data.diff(resource.data).affectedKeys())
        && !('squareCustomerId'     in request.resource.data.diff(resource.data).affectedKeys())
        && !('squareSubscriptionId' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId ||
         isAdmin());

      // Business Library documents subcollection — owner only
      match /documents/{docId} {
        allow read, write, delete: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.uid ||
           request.auth.uid == businessId);
      }

      // Campaigns subcollection — owner read/write (uid field on each doc), admin full access
      match /campaigns/{campId} {
        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.uid || isAdmin());
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.uid;
        allow update, delete: if request.auth != null &&
          (request.auth.uid == resource.data.uid || isAdmin());
      }
    }

    // Listing drafts — owner only; admin can read any
    // uid field is immutable after create — can't be reassigned to another user
    match /listingDrafts/{draftId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.uid &&
        !('uid' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    // Publish jobs — read by owner or admin; writes only by admin (browser tools) or backend
    // Regular users must NOT update job status — that would let them falsify publish results.
    match /publishJobs/{jobId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Platform connections — owner read; admin read/write; owner may only set status→disconnected
    // All other field changes (tokens, locationId, etc.) must go through Cloud Functions (Admin SDK).
    match /platformConnections/{connId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if isAdmin();
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      // Owners may disconnect their own connection but cannot write any other field
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'disconnected';
    }

    // Subscriptions — owner read only (written by Square webhook backend); admin can read any
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (request.auth.uid == subId || isAdmin());
      allow write: if false;
    }

    // Activity logs — owner can create (bb:addHistory); admin can read any
    match /activityLogs/{logId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow write: if false;
    }

    // Reviews — owner read only (written by backend); admin can read any
    match /reviews/{reviewId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Settings (pricing etc) — public read, backend-only write
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Platform category cache — public read (any authenticated user), backend-only write
    match /platformCategoryCache/{platform} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pending posts (review queue) — owner read only; all writes via Cloud Functions (Admin SDK)
    // Direct client writes blocked to prevent status/content spoofing.
    // approvePendingPost CF handles approve/skip state transitions.
    match /pendingPosts/{postId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write, create, update, delete: if isAdmin();
    }

    // Copy Library — owner read/write; admin can read any
    // uid field is immutable after create — prevents doc reassignment across users
    match /copyLibrary/{docId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.uid &&
        !('uid' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    // AI usage logs — written by backend only; admin can read
    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email templates — admin read/write only; Cloud Functions use Admin SDK (bypasses rules)
    match /emailTemplates/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin config (admin email list, feature flags, etc.) — admin only
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // OAuth nonces — written/deleted by Cloud Functions (admin SDK, bypasses rules)
    // Explicitly blocked from direct client access
    match /oauthNonces/{nonceId} {
      allow read, write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

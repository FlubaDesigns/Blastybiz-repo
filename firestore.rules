rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — full read access across all collections.
    // info@blastybiz.com is the permanent bootstrap admin (cannot be removed via UI).
    // Additional admins are stored in config/admins and managed from Admin-Operate.html.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email == 'info@blastybiz.com' ||
        (exists(/databases/$(database)/documents/config/admins) &&
         request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails)
      );
    }

    // Deletion journal is server-only and survives partial cleanup.
    function accountOpen(uid) {
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    // Users can only read/write their own user doc; admin can read any.
    // plan, planActive, and aiUsage are server-only — blocked from client writes.
    //
    // ✅ ALLOWLIST (2.10) — new fields fail CLOSED. If you add a client-writable
    //    field to user docs, you MUST add it to BOTH hasOnly() lists below.
    //    Server-only fields (plan, planActive, aiUsage*, etc.) must NOT be added.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId && accountOpen(userId) || isAdmin());
      // Admin can write any field (plan override tool, support, etc.)
      allow write: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId && accountOpen(userId)
        && request.resource.data.plan in ['starter', 'trial']
        && request.resource.data.keys().hasOnly([
            'ownerName', 'email', 'displayName', 'plan', 'onboarded', 'createdAt',
            'activeBusiness', 'onboardingVersion', 'onboardingProgress',
            'onboardingCompleted', 'setupHandoff', 'blastySeen'
          ]);
      // ✅ ALLOWLIST — new fields fail CLOSED. A field missing from this list
      //    silently aborts the whole write, including atomic onboarding batches.
      //    'lastActiveAt' is the dormancy signal for free-account retention; it
      //    is client-writable on purpose (activity-ping.js). Worst case an owner
      //    keeps their own account alive, which is the safe direction.
      allow update: if request.auth != null && request.auth.uid == userId && accountOpen(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerName', 'email', 'displayName', 'onboarded', 'activeBusiness',
            'updatedAt', 'onboardingProgress', 'onboardingVersion',
            'onboardingCompleted', 'lastActiveAt', 'setupHandoff', 'blastySeen', 'loginGuideDone'
          ]);

      // Businesses — nested under users/{uid}/businesses/{bizId}
      // Owner check: uid field matches the parent user doc path segment.
      //
      // ✅ ALLOWLIST (2.10) — new fields fail CLOSED. If you add a client-writable
      //    field to business docs, add it to BOTH hasOnly() lists below.
      //    Server-only fields (currentPlan, subscriptionStatus, squareCustomerId,
      //    squareSubscriptionId) must NOT be added.
      match /businesses/{bizId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId && accountOpen(userId) || isAdmin());
        // Creation and capacity enforcement are owned by createBusiness.
        allow create: if isAdmin();
        allow update: if request.auth != null &&
          request.auth.uid == userId && accountOpen(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'businessName', 'name', 'ownerName', 'ownerRole', 'category',
              'phone', 'email', 'street', 'city', 'state', 'zip', 'address',
              'website', 'hours', 'locationType', 'region', 'tone',
              'ynMentionName', 'ynMentionRole', 'ynMentionAddress',
              'ynMentionPhone', 'ynMentionWebsite', 'ynMentionEmail',
              'story', 'different', 'awards', 'customer', 'otherInfo',
              'businessDescription', 'toggles', 'onboarded', 'onboardingVersion',
              'activeCampaign', 'enabledPlatforms',
              'globalMemory', 'featuredPhoto', 'aiContext', 'bizInsights',
              'platformCats', 'postingSchedule', 'platformPrefs',
              'schedulingPaused', 'updatedAt'
            ]);
        allow delete: if false; // deleteBusiness/adminDeleteBusiness own pointer repair and recursive cleanup.

        // Business Library documents subcollection — owner only
        match /documents/{docId} {
          allow read, write, delete: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId);
        }

        // Global business facts subcollection — owner only
        // bizId field must match the path segment on create.
        match /facts/{factId} {
          allow read: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          allow create: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            request.resource.data.bizId == bizId;
          allow update, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
        }

        // Global business images subcollection — owner only
        // bizId field must match the path segment on create.
        match /images/{imageId} {
          allow read: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          allow create: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            request.resource.data.bizId == bizId;
          allow update, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
        }

        // Campaigns subcollection — owner read/write (uid field on each doc), admin full access
        match /campaigns/{campId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId && accountOpen(userId) || isAdmin());
          allow create: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId);
          allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId && accountOpen(userId) &&
            resource.data.get('status','active') != 'archived' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'archivedAt']));
        allow delete: if isAdmin();

          // Reusable Ads and their event history are written by manageAd.
          match /ads/{adId} {
            allow read: if request.auth != null && (request.auth.uid == userId && accountOpen(userId) || isAdmin());
            allow write: if false;
          }

          // Campaign facts subcollection
          // bizId and campaignId fields must match path segments on create.
          match /facts/{factId} {
            allow read: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
            allow create: if request.auth != null &&
              request.auth.uid == userId && accountOpen(userId) &&
              request.resource.data.bizId == bizId &&
              request.resource.data.campaignId == campId;
            allow update, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          }

          // Campaign images subcollection
          match /images/{imageId} {
            allow read: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
            allow create: if request.auth != null &&
              request.auth.uid == userId && accountOpen(userId) &&
              request.resource.data.bizId == bizId &&
              request.resource.data.campaignId == campId;
            allow update, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          }

          // Campaign documents (flyers, menus, etc.)
          match /documents/{docId} {
            allow read, write, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          }

          // Campaign copy (generated copy library per campaign)
          match /copy/{copyId} {
            allow read, write, delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId);
          }
        }

        // Listing drafts — owner only; admin can read any
        // uid field is immutable after create — can't be reassigned to another user
        match /listingDrafts/{draftId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId && accountOpen(userId) || isAdmin());
          allow create: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            !request.resource.data.keys().hasAny(['freeRegenUsed', 'freeRegenEligible', 'packet', 'packetFrozenAt', 'scheduleAdPath', 'scheduledForUtc', 'approvalStatus', 'completion', 'completedAt', 'readyAt', 'reminders', 'preparationState']);
          allow update: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'freeRegenUsed', 'freeRegenEligible', 'packet', 'packetFrozenAt', 'scheduleAdPath', 'scheduledForUtc', 'approvalStatus', 'completion', 'completedAt', 'readyAt', 'reminders', 'preparationState']) &&
            (!resource.data.keys().hasAny(['scheduleAdPath'])) &&
            (!resource.data.keys().hasAny(['packet']) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schedule','updatedAt']));
          allow delete: if request.auth != null && request.auth.uid == userId && accountOpen(userId) &&
            !resource.data.keys().hasAny(['packet']);
          match /private/{document} { allow read, write: if false; }
        }

        // Publish jobs — read by owner or admin; writes only by admin (browser tools) or backend
        // Regular users must NOT update job status — that would let them falsify publish results.
        match /publishJobs/{jobId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId && accountOpen(userId) || isAdmin());
          allow write: if isAdmin();
          allow create, update, delete: if isAdmin();
        }

        // Platform connections — owner read; admin read/write
        // OAuth identity/binding fields are server-only; owners may edit display metadata.
        // Sensitive OAuth tokens are stored in the private/tokens subcollection below — never on this doc.
        match /platformConnections/{connId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId && accountOpen(userId) || isAdmin());
          allow write: if isAdmin();
          allow create: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            (!(connId in ['google','facebook','instagram']) || (request.resource.data.keys().hasOnly(['uid','businessId','platform','platformName','profileUrl','updatedAt']) && request.resource.data.uid == userId && request.resource.data.businessId == bizId && request.resource.data.platform == connId));
          allow update: if request.auth != null &&
            request.auth.uid == userId && accountOpen(userId) &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['accessToken', 'refreshToken', 'locationId', 'pageId', 'pageToken', 'code', 'tokenExpiry']) &&
            (!(connId in ['google','facebook','instagram']) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid','businessId','platform','status','instagramAuthorized','accountId','igUserId','expiresAt','connectedAt','disconnectedAt','locationName','pageName']));

          // Private subcollection — OAuth tokens. Denied to ALL browser clients.
          // Only Cloud Functions (Admin SDK) may read or write these documents.
          match /private/{doc} {
            allow read, write: if false;
          }
        }

        // Pending posts (review queue) — owner read only; all writes via Cloud Functions (Admin SDK)
        // Direct client writes blocked to prevent status/content spoofing.
        // approvePendingPost CF handles approve/skip state transitions.
        match /pendingPosts/{postId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId && accountOpen(userId) || isAdmin());
          allow write, create, update, delete: if isAdmin();
        }
      }
    }

    // collectionGroup queries for admin cross-user views
    // These allow admins to query publishJobs/platformConnections/pendingPosts/listingDrafts
    // across all businesses without needing a specific uid/bizId path.
    match /{path=**}/businesses/{bizId} {
      allow read: if isAdmin();
    }
    match /{path=**}/publishJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /{path=**}/platformConnections/{connId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /{path=**}/pendingPosts/{postId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /{path=**}/listingDrafts/{draftId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Subscriptions — owner read only (written by Square webhook backend); admin can read any
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (request.auth.uid == subId || isAdmin());
      allow write: if false;
    }

    // Activity logs — owner can create (bb:addHistory); admin can read any
    match /activityLogs/{logId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid && accountOpen(request.auth.uid);
      allow write: if false;
    }

    // Reviews — owner read only (written by backend); admin can read any
    match /reviews/{reviewId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Settings (pricing etc) — public read, backend-only write
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Platform category cache — public read (any authenticated user), backend-only write
    match /platformCategoryCache/{platform} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Copy Library — owner read/write; admin can read any
    // uid field is immutable after create — prevents doc reassignment across users
    match /copyLibrary/{docId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid && accountOpen(request.auth.uid);
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.uid && accountOpen(request.auth.uid) &&
        !('uid' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid && accountOpen(request.auth.uid);
    }

    // AI usage logs — written by backend only; admin can read
    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Email templates — admin read/write only; Cloud Functions use Admin SDK (bypasses rules)
    match /emailTemplates/{docId} {
      allow read, write: if isAdmin();
    }

    // OB1 step text/anim overrides — public read so onboarding users get live customizations
    match /config/ob1Steps {
      allow read: if true;
      allow write: if isAdmin();
    }

    // OB2 quick-form text overrides — public read so onboarding users get live customizations
    match /config/ob2Steps {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Start page text overrides — public read so unauthenticated visitors get live customizations
    match /config/startPage {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Platform listing & display config — public read so public pages render dynamically
    match /config/platforms {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Login page Blasty guide messages — public read so Login page renders without auth
    match /config/loginGuide {
      allow read: if true;
      allow write: if isAdmin();
    }


    // Admin-authored guidance is public, including the signed-out setup page.
    match /config/blasty {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin config (admin email list, feature flags, plans, etc.) — admin only
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // OAuth nonces — written/deleted by Cloud Functions (admin SDK, bypasses rules)
    // Explicitly blocked from direct client access
    match /oauthNonces/{nonceId} {
      allow read, write: if false;
    }

    // Draft action records (approve/skip single-use records) — admin SDK only
    // Client must never read or write these — they guard action-link integrity.
    match /draftActions/{docId} {
      allow read, write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

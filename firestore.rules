rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — perceys@gmail.com gets full read across all collections
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'perceys@gmail.com';
    }

    // Users can only read/write their own user doc; admin can read any
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Businesses — owner only (uid field matches auth uid, not document ID); admin can read any
    match /businesses/{businessId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Listing drafts — owner only; admin can read any
    match /listingDrafts/{draftId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Publish jobs — owner only (create + read; backend updates status); admin can read any
    match /publishJobs/{jobId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Platform connections — owner only; admin can read any
    match /platformConnections/{connId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Subscriptions — owner read only (written by Stripe webhook backend); admin can read any
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (request.auth.uid == subId || isAdmin());
      allow write: if false;
    }

    // Activity logs — owner read only (written by backend); admin can read any
    match /activityLogs/{logId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Reviews — owner read only (written by backend); admin can read any
    match /reviews/{reviewId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Settings (pricing etc) — public read, backend-only write
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

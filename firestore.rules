rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — full read access across all collections
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'perceys@gmail.com' ||
        request.auth.token.email == 'rep-test@blastybiz.com'
      );
    }

    // Users can only read/write their own user doc; admin can read any
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Businesses — owner only; admin can read or delete any.
    // Owner check: uid field on the doc OR the doc ID (activeBizId defaults to user.uid).
    match /businesses/{businessId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId ||
         isAdmin());
      allow write: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId);
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.uid ||
         request.auth.uid == businessId);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid == businessId ||
         isAdmin());
    }

    // Listing drafts — owner only; admin can read any
    match /listingDrafts/{draftId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Publish jobs — owner only (create + read; backend updates status); admin can read any
    match /publishJobs/{jobId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Platform connections — owner only; admin can read any
    match /platformConnections/{connId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Subscriptions — owner read only (written by Stripe webhook backend); admin can read any
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (request.auth.uid == subId || isAdmin());
      allow write: if false;
    }

    // Activity logs — owner read only (written by backend); admin can read any
    match /activityLogs/{logId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Reviews — owner read only (written by backend); admin can read any
    match /reviews/{reviewId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if false;
    }

    // Settings (pricing etc) — public read, backend-only write
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Platform category cache — public read (any authenticated user), backend-only write
    match /platformCategoryCache/{platform} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Pending posts (review queue) — owner read/write; backend creates via Admin SDK
    match /pendingPosts/{postId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Copy Library — owner read/write; admin can read any
    match /copyLibrary/{docId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // AI usage logs — written by backend only; admin can read
    match /aiUsageLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

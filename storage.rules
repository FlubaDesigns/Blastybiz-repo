rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {

    // Users can read their own uploaded images
    match /users/{uid}/images/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Writes go through uploadImage CF only
    }

    // Active upload path used by uploadImage CF
    match /photos/{uid}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Writes go through uploadImage CF only
    }

    // Business images (schema migration path) — read only
    match /businesses/{bizId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false; // Writes go through Cloud Functions only
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
